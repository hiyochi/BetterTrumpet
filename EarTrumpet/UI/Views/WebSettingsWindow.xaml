<Window x:Class="EarTrumpet.UI.Views.WebSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
        xmlns:resx="clr-namespace:EarTrumpet.Properties"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Name="WindowRoot"
        Title="{x:Static resx:Resources.SettingsWindowText}"
        Width="960"
        Height="680"
        MinWidth="700"
        MinHeight="480"
        Theme:AcrylicBrush.Background="AcrylicColor_Settings"
        Theme:Options.Source="App"
        Background="Transparent"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Style="{StaticResource DialogWindowStyle}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Background="Transparent">
        <wv2:WebView2 x:Name="SettingsWebView"
                      AllowExternalDrop="False"
                      DefaultBackgroundColor="0" />

        <!-- Branded splash covering the WebView2 cold-start phase. The window
             itself is Transparent + non-layered, which paints black until the
             first web frame; this layer shows the shell color instead and is
             faded out when the React app reports it has rendered. -->
        <Grid x:Name="LoadingSplash"
              Background="#050706"
              IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Image x:Name="SplashLogo"
                       Width="64"
                       Height="64"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/icon.png" />
                <TextBlock Margin="0,16,0,20"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#F4F7F5"
                           Opacity="0.9"
                           Text="{x:Static resx:Resources.WebSettingsLoading}" />
                <ProgressBar Width="160"
                             Height="3"
                             BorderThickness="0"
                             Background="#18FFFFFF"
                             Foreground="#9B7BEA"
                             IsIndeterminate="True" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ErrorOverlay"
              Visibility="Collapsed"
              Background="Transparent">
            <StackPanel Width="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           Text="{x:Static resx:Resources.WebSettingsLoadErrorTitle}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,22"
                           FontSize="13"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{x:Static resx:Resources.WebSettingsLoadErrorDescription}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button MinWidth="96"
                            Padding="16,7"
                            Click="Retry_Click"
                            Content="{x:Static resx:Resources.WebSettingsRetryButton}" />
                    <Button MinWidth="130"
                            Margin="10,0,0,0"
                            Padding="16,7"
                            Click="OpenClassic_Click"
                            Content="{x:Static resx:Resources.WebSettingsClassicButton}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
