<Window x:Class="EarTrumpet.UI.Views.WebSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
        xmlns:resx="clr-namespace:EarTrumpet.Properties"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Name="WindowRoot"
        Title="{x:Static resx:Resources.SettingsWindowText}"
        Width="960"
        Height="680"
        MinWidth="700"
        MinHeight="480"
        Theme:AcrylicBrush.Background="AcrylicColor_Settings"
        Theme:Options.Source="App"
        Background="Transparent"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Style="{StaticResource DialogWindowStyle}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Background="Transparent">
        <wv2:WebView2 x:Name="SettingsWebView"
                      AllowExternalDrop="False"
                      DefaultBackgroundColor="Transparent" />

        <Grid x:Name="LoadingOverlay"
              Background="Transparent"
              IsHitTestVisible="False">
            <ProgressBar Width="180"
                         Height="4"
                         IsIndeterminate="True" />
        </Grid>

        <Grid x:Name="ErrorOverlay"
              Visibility="Collapsed"
              Background="Transparent">
            <StackPanel Width="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           Text="{x:Static resx:Resources.WebSettingsLoadErrorTitle}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,22"
                           FontSize="13"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="{x:Static resx:Resources.WebSettingsLoadErrorDescription}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button MinWidth="96"
                            Padding="16,7"
                            Click="Retry_Click"
                            Content="{x:Static resx:Resources.WebSettingsRetryButton}" />
                    <Button MinWidth="130"
                            Margin="10,0,0,0"
                            Padding="16,7"
                            Click="OpenClassic_Click"
                            Content="{x:Static resx:Resources.WebSettingsClassicButton}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
