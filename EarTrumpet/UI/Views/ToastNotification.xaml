<Window x:Class="EarTrumpet.UI.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastNotification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Border x:Name="ToastBorder"
            Background="#E6111111"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14"
            Margin="0"
            RenderTransformOrigin="0.5,1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="32" ShadowDepth="8" Direction="270"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="TranslateTransform" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <StackPanel Orientation="Horizontal">
            <Border Background="#1AFFFFFF"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="#E6FFFFFF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="#E6FFFFFF"
                       VerticalAlignment="Center"
                       MaxWidth="280"
                       TextWrapping="Wrap"
                       LineHeight="18"/>
        </StackPanel>
    </Border>
</Window>
