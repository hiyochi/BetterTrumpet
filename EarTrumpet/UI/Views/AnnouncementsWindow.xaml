<Window x:Class="EarTrumpet.UI.Views.AnnouncementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
        xmlns:resx="clr-namespace:EarTrumpet.Properties"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Name="WindowRoot"
        Title="{x:Static resx:Resources.AnnouncementsTitle}"
        Width="720"
        Height="680"
        MinWidth="480"
        MinHeight="400"
        Theme:AcrylicBrush.Background="AcrylicColor_Settings"
        Theme:Options.Source="App"
        Background="Transparent"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Style="{StaticResource DialogWindowStyle}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Background="Transparent">
        <wv2:WebView2 x:Name="AnnouncementsWebView"
                      AllowExternalDrop="False"
                      DefaultBackgroundColor="0" />

        <!-- Branded splash covering the WebView2 cold-start phase. -->
        <Grid x:Name="LoadingSplash"
              Background="#050706"
              IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Image Width="64"
                       Height="64"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/icon.png" />
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#F4F7F5"
                           Opacity="0.9"
                           Text="{x:Static resx:Resources.AnnouncementsLoading}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ErrorOverlay"
              Visibility="Collapsed"
              Background="#050706">
            <StackPanel Width="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#F4F7F5"
                           Text="{x:Static resx:Resources.AnnouncementsLoadErrorTitle}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,22"
                           FontSize="13"
                           Foreground="#9AA3A0"
                           Text="{x:Static resx:Resources.AnnouncementsLoadErrorDescription}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <Button MinWidth="96"
                            Padding="16,7"
                            Click="Retry_Click"
                            Content="{x:Static resx:Resources.AnnouncementsRetryButton}" />
                    <Button MinWidth="96"
                            Margin="10,0,0,0"
                            Padding="16,7"
                            Click="Close_Click"
                            Content="{x:Static resx:Resources.AnnouncementsCloseButton}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>